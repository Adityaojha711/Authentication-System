<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password</title>
    <link rel="stylesheet" href="/stylesheet/style.css" />
  </head>
  <body>
    <div class="container form-card">
      <div class="page-header">
        <h1>Change Password</h1>
        <p>Enter your current password and choose a new one.</p>
      </div>

      <form action="/resetpassword" method="post">
        <input type="password" name="oldPassword" placeholder="Current password" required autocomplete="current-password" />
        <input type="password" name="newPassword" placeholder="New password" required autocomplete="new-password" />
        <input type="submit" value="Update password" />
      </form>

      <div class="links">
        <a class="btn btn-secondary" href="/profile">Back to profile</a>
      </div>
    </div>
  </body>
</html>